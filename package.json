{
  "name": "agentx-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ANP message layer: connectx CLI + AgentXAgent ANPMessageService.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eccstartup/ANPMessageService.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @agentx/cli",
    "build:core": "npm run build --workspace @agentx/core",
    "build:cli": "npm run build --workspace @agentx/cli",
    "build:service": "npm run build --workspace @agentx/service",
    "typecheck:core": "npm run typecheck --workspace @agentx/core",
    "typecheck:cli": "npm run typecheck --workspace @agentx/cli",
    "typecheck:service": "npm run typecheck --workspace @agentx/service",
    "test:core": "npm run test --workspace @agentx/core",
    "test:cli": "npm run test --workspace @agentx/cli",
    "test:service": "npm run test --workspace @agentx/service",
    "docs:dev": "npm --prefix vercel run docs:dev",
    "docs:build": "npm --prefix vercel run docs:build",
    "docs:preview": "npm --prefix vercel run docs:preview"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
